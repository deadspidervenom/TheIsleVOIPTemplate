App.ForceIPBinding=False
App.SupportsIPv6=False
App.ApplicationIPBinding=127.0.0.1
App.Ports=[{"Protocol":"TCP","Port":27010,"Ref":"ConfigSocketPort","Name":"Config Socket","Description":"TCP port the injector listens on to serve audio config to Mumble plugins. Bind to 127.0.0.1 only."}]
App.AdminPortRef=0
App.PrimaryApplicationPortRef=ConfigSocketPort
App.UniversalSleepApplicationUDPPortRef=0
App.UniversalSleepSteamQueryPortRef=0
