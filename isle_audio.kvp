Console.FilterMatchRegex=
Console.FilterMatchReplacement=
Console.ThrowawayMessageRegex=
Console.AppReadyRegex=^\[INIT\] Isle Injector started$
Console.UserJoinRegex=^\[LINK\] SteamID (?<sessionid>\d+?) linked to hash (?<username>[a-f0-9]+?)$
Console.UserLeaveRegex=^\[KICK\] Kicked SteamID (?<sessionid>\d+?): .+$
Console.UserChatRegex=^$
Console.UpdateAvailableRegex=^$
Console.PreConnectRegex=^$
Console.MetricsRegex=^\[STATS\] online=(?<Players>\d+) linked=(?<Linked>\d+) unlinked=(?<Unlinked>\d+) mumble_online=(?<MumbleOnline>\d+)$
