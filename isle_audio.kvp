Meta.DisplayName=Isle Evrima Positional Audio
Meta.Description=Manages the isle_injector.exe process that bridges The Isle Evrima dedicated server with Mumble positional audio. Handles player position reading, SteamID64 linking, kick timers, and audio config serving.
Meta.OS=Windows
Meta.AarchSupport=Native
Meta.Arch=All
Meta.Author=Isle Audio Project
Meta.URL=
Meta.DisplayImageSource=
Meta.EndpointURIFormat=
Meta.ConfigManifest=isle_audioconfig.json
Meta.MetaConfigManifest=isle_audiometaconfig.json
Meta.ConfigRoot=isle_audio.kvp
Meta.MinAMPVersion=2.5.0.12
Meta.SpecificDockerImage=
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=NotSupported
Meta.ContainerPolicyReason=isle_injector.exe requires direct memory access to TheIsle-Win64-Shipping.exe and must run on the same Windows host as the game server.
Meta.ExtraSetupStepsURI=
Meta.Prerequsites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.AppConfigId=
Meta.ConfigVersion=1.0.0
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppIsMultiIPAware=False
